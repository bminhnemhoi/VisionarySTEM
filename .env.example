# VisionarySTEM - Environment Variables Template
# Copy this file to .env and fill in your values
# Sao chép file này thành .env và điền giá trị của bạn

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
TTS_VOICE=vi-VN-HoaiMyNeural
MAX_FILE_SIZE_MB=20

# CORS (comma-separated origins). Use "*" only in dev.
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Tenant mode: "single" (cho cuộc thi) hoặc "multi" (production SaaS)
TENANT_MODE=single

# JWT (multi-tenant only — generate strong secret in production)
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Persistent storage (multi-tenant)
DATABASE_URL=
REDIS_URL=
CHROMA_PERSIST_DIR=
